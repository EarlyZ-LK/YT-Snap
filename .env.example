OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional: require this token in the UI (recommended if the app is reachable from the internet)
ACCESS_TOKEN=
# yt-dlp needs a JS runtime for YouTube; Node is in the image
YTDLP_EXTRA_ARGS=--js-runtimes node --remote-components ejs:github
# yt-dlp build channel: nightly (default), master (newest fixes) or stable
YTDLP_CHANNEL=nightly
